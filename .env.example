# ============================================================
# HakamChain (حَکَم‌چین) — environment variables
# Copy this file to `.env` and fill in the values.
# NEVER commit the real .env file or your private key anywhere.
# ============================================================

# --- Server -------------------------------------------------
PORT=3000
NODE_ENV=development
# A long random string used to sign session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Blockchain (Ethereum Sepolia testnet) -------------------
CHAIN_ID=11155111
# Any Sepolia JSON-RPC endpoint. Public options (no key needed):
#   https://ethereum-sepolia-rpc.publicnode.com
#   https://rpc.sepolia.org
# Or your own Alchemy/Infura endpoint.
RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the ADMIN wallet (the platform حَکَم) that signs
# releaseFunds() transactions. USE A FRESH BURNER WALLET WITH
# TESTNET ETH ONLY. Fund it from a Sepolia faucet.
# NEVER put a mainnet key here. NEVER commit .env to git.
ADMIN_PRIVATE_KEY=

# Address of the deployed IslamicEscrow contract (printed by
# `npm run deploy:sepolia`, also saved in deployments/sepolia.json)
CONTRACT_ADDRESS=

# Comma-separated list of lowercase wallet addresses allowed to
# open the admin panel (SIWE login). Example:
# ADMIN_ADDRESSES=0xabc...,0xdef...
ADMIN_ADDRESSES=

# --- Database ------------------------------------------------
# SQLite file path (directory is created automatically)
DB_STORAGE=./data/hakamchain.sqlite

# --- Limits --------------------------------------------------
# Informational mirror of the on-chain safe margin (contract
# enforces the real cap of 0.05 ETH per deposit).
MAX_DEPOSIT_ETH=0.05
