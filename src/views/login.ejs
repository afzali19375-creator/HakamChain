<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="flex-1 flex items-center justify-center px-4 py-10">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-8">
      <div class="text-center mb-6">
        <div class="mx-auto h-14 w-14 rounded-2xl bg-emerald-600 text-white flex items-center justify-center text-2xl font-extrabold shadow">ح</div>
        <h1 class="mt-4 text-xl font-extrabold text-stone-900">ورود به حَکَم‌چین</h1>
        <p class="mt-2 text-sm text-stone-500 leading-6">
          با استاندارد <span class="font-medium text-stone-700" dir="ltr">SIWE</span>
          (Sign-In with Ethereum) وارد شوید؛ امضای شما فقط هویت کیف پول را تایید می‌کند و هیچ تراکنشی روی زنجیره انجام نمی‌دهد.
        </p>
      </div>

      <button id="btn-connect-login"
              class="w-full rounded-xl bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold py-3 transition shadow-sm">
        اتصال کیف پول و ورود
      </button>

      <p id="login-status" class="mt-4 text-center text-sm text-stone-500 min-h-5"></p>

      <div class="mt-6 rounded-xl bg-stone-50 border border-stone-200 p-4 text-xs text-stone-500 leading-6">
        <p class="font-semibold text-stone-700 mb-1">مراحل ورود:</p>
        <ol class="list-decimal ps-5 space-y-0.5">
          <li>اتصال کیف پول MetaMask و اطمینان از بودن روی شبکه <b>Sepolia</b></li>
          <li>امضای پیام ورود (بدون کارمزد)</li>
          <li>تایید هویت سمت سرور و ساخت نشست امن</li>
        </ol>
        <p class="mt-2">دسترسی پنل حَکَم فقط به آدرس‌های تعریف‌شده در <span dir="ltr" class="font-mono">ADMIN_ADDRESSES</span> داده می‌شود.</p>
      </div>
    </div>
    <p class="mt-4 text-center text-xs text-stone-400">
      کیف پول ندارید؟ <span dir="ltr">MetaMask</span> را نصب کنید و از فاست‌های رایگان، اتر آزمایشی Sepolia بگیرید.
    </p>
  </div>
</main>

<script type="application/json" id="page-data"><%- JSON.stringify(pageData) %></script>
<script src="/js/app.js" defer></script>
<%- include('partials/footer') %>
</body>
</html>
